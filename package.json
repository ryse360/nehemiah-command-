{
  "name": "nehemiah-command",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "security:hash-password": "node --import tsx scripts/hash-founder-password.ts",
    "security:check-readiness": "node --import tsx scripts/check-production-readiness.ts",
    "security:verify-backup": "node --import tsx scripts/verify-backup-manifest.ts",
    "quality:performance": "node --import tsx scripts/check-performance-budget.ts",
    "quality:smoke": "node --import tsx scripts/smoke-production.ts",
    "deployment:rehearse": "node --import tsx scripts/rehearse-deployment.ts",
    "release:audit": "node --import tsx scripts/audit-release-candidate.ts",
    "release:verify-production": "node --import tsx scripts/audit-release-candidate.ts --require-production",
    "quality:headers": "node --import tsx scripts/check-security-headers.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "postgres": "3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  },
  "type": "module"
}
