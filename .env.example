DATABASE_URL=postgres://user:password@host:5432/nehemiah?sslmode=require
NEHEMIAH_FOUNDER_ID=primary-founder
# Generate with: npm run security:hash-password -- "your passphrase"
NEHEMIAH_FOUNDER_PASSWORD_HASH=scrypt$...
NEHEMIAH_SESSION_SECRET=replace-with-at-least-32-random-bytes
NEHEMIAH_SESSION_TTL_SECONDS=43200
NEHEMIAH_AUTH_VERSION=1

# JSON object mapping approved integration IDs to private ingest keys.
NEHEMIAH_INTEGRATION_KEYS={"google-calendar":{"current":"replace-with-long-random-key","previous":"optional-old-key","previousExpiresAt":"2026-08-01T00:00:00.000Z"}}

# v0.17.1 production exit gate
# Distributed rate limits use DATABASE_URL and migration 004.
# Run before deployment: npm run security:check-readiness

# v0.18 governed AI orchestration
NEHEMIAH_AI_API_KEY=replace-with-provider-key
NEHEMIAH_AI_MODEL=replace-with-structured-output-capable-model
# Optional OpenAI-compatible base URL; defaults to https://api.openai.com/v1
NEHEMIAH_AI_BASE_URL=https://api.openai.com/v1
